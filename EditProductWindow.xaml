<Window x:Class="ShopProductManagerApp.EditProductWindow"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopProductManagerApp"
        mc:Ignorable="d"
        Title="Редактирование товара" Height="320" Width="400"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/product-control.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="ProductNameTextBox" Grid.Row="2" Margin="20 7 20 7" FontSize="12"
                materialDesign:HintAssist.Hint="Название товара" BorderThickness="3" 
                BorderBrush="{DynamicResource MaterialDesignDivider}" 
                Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

        <TextBox x:Name="ProductPriceTextBox" Grid.Row="3" Margin="20 7 20 7" FontSize="12"
                materialDesign:HintAssist.Hint="Цена" BorderThickness="3" 
                BorderBrush="{DynamicResource MaterialDesignDivider}" 
                Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

        <TextBox x:Name="ProductDescriptionTextBox" Grid.Row="4" Margin="20 7 20 7" FontSize="12"
                materialDesign:HintAssist.Hint="Описание" BorderThickness="3" 
                BorderBrush="{DynamicResource MaterialDesignDivider}" 
                Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

        <Button x:Name="ConfirmButton" Grid.Row="6" Margin="40 7 40 7" Height="40" FontWeight="Bold"
                FontSize="18" Content="✔️" Click="ConfirmButton_Click"
                materialDesign:ButtonAssist.CornerRadius="10"
                Style="{StaticResource MaterialDesignRaisedButton}"/>
    </Grid>
</Window>
